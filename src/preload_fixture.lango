import js "node:crypto" as crypto

export edit(input)
export pageLayout(selected)
export pageScreen(selected)

global moduleId = crypto/randomUUID()

edit(input)
    global moduleId
    context form
    form.city.value = "Saved: ${form.city.value}"
    form.saveButton.enabled = false
    return {
        moduleId: moduleId
    }

pageLayout(selected)
    return {
        type: "Container"
        controls: [{
            type: "Container"
            name: "__content__"
            controls: []
        }]
    }

pageScreen(selected)
    global moduleId
    return {
        type: "Form"
        controls: [{
            type: "Value"
            name: "moduleId"
            value: moduleId
        }]
    }
