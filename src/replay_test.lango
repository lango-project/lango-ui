import js global Promise
import js global Date
import js global globalThis as host
import "./library"
    class Dispatcher
import "./replay"
    class MemoryReplayStore

export main(args)

class Reply
    properties
        code
        body
        headers
    methods
        status(code)
        header(name, value)
        send(body)
        discardTokenChanges()

Reply()
    @code = 200
    @headers = {
    }

Reply:status(code)
    @code = code
    return @this

Reply:header(name, value)
    @headers[name] = value
    return @this

Reply:send(body)
    @body = body
    return body

Reply:discardTokenChanges()
    return null

class Handler
    properties
        calls
        blocking
        failing
        rejection
        mutate
        pending
        observedState
    methods
        handle(input)
        mode(mode)

Handler()
    @calls = []
    @blocking = false
    @failing = false
    @rejection = false
    @mutate = false
    @pending = Promise/withResolvers()

Handler:handle(input)
    @observedState = currentState()
    @calls.add(input.seqno)
    if @mutate
        input.seqno = 100
    if @failing
        throw "ExpectedHandlerFailure"
    if @rejection
        return Promise/reject("ExpectedHandlerFailure")
    if @blocking
        return @pending.promise
    return {
        text: "handled"
    }

currentState()
    context state
    try
        return state
    catch error
        return null

Handler:mode(mode)
    @failing = mode == "fail"
    @rejection = mode == "reject"
    @blocking = mode == "block"
    @mutate = mode == "mutate"
    return null

createDispatcher(store, handler)
    result = new Dispatcher(".", {
        replayStore: store
    })
    callback = (input)
        capture handler
        return handler.handle(input)
    result.event({
        path: "/save"
        function: callback
    })
    result.event({
        path: "/other"
        function: callback
    })
    return result

invoke(dispatcher, seqno, reply, instance = "instance", session = "session", form = "profile", path = "/save")
    context request = {
        id: "request"
        path: path
    }
    context response = reply
    context token = {
        sessionId: session
        sessionExpiresAt: Date/now() / 1000 + 3600
    }
    return dispatcher.handle({
        formId: form
        formInstanceId: instance
        seqno: seqno
        values: {
            text: "input"
        }
    })

main(args)
    checkCapacity()
    checkInvalidInput()
    return checkDuplicates().then(()
        return checkFailures()
    ).then(()
        return checkPending()
    ).then(()
        return checkScopes()
    ).then(()
        return checkMutation()
    ).then(()
        return checkInvalidStore()
    ).then(()
        return checkFullStore()
    ).then(()
        return checkContextStore()
    )

checkDuplicates()
    handler = new Handler()
    dispatcher = createDispatcher(new MemoryReplayStore(), handler)
    return invoke(dispatcher, 1, new Reply()).then((result)
        capture dispatcher
        capture handler
        assert handler.calls.length == 1
        return checkDuplicate(dispatcher, handler)
    )

checkDuplicate(dispatcher, handler)
    reply = new Reply()
    return invoke(dispatcher, 1, reply).then((result)
        capture dispatcher
        capture handler
        capture reply
        assertConflict(reply, "AlreadyConsumed")
        assert handler.calls.length == 1
        return invoke(dispatcher, 3, new Reply())
    ).then((result)
        capture dispatcher
        capture handler
        assert result.seqno == 3
        return checkStale(dispatcher, handler)
    )

checkStale(dispatcher, handler)
    reply = new Reply()
    return invoke(dispatcher, 2, reply).then((result)
        capture dispatcher
        capture handler
        capture reply
        assertConflict(reply, "AlreadyConsumed")
        assert handler.calls.length == 2
        return checkOtherPath(dispatcher, handler)
    )

checkOtherPath(dispatcher, handler)
    reply = new Reply()
    return invoke(dispatcher, 3, reply, "instance", "session", "profile", "/other").then((result)
        capture handler
        capture reply
        assertConflict(reply, "AlreadyConsumed")
        assert handler.calls.length == 2
        println("PASS duplicate and older sequences are rejected across routes; gaps remain allowed")
    )

assertConflict(reply, reason)
    assert reply.code == 409
    assert reply.body.error == "UiReplayConflict"
    assert reply.body.reason == reason
    assert reply.headers["Cache-Control"] == "no-store"
    return null

checkFailures()
    handler = new Handler()
    handler.failing = true
    dispatcher = createDispatcher(new MemoryReplayStore(), handler)
    return expectFailure(invoke(dispatcher, 1, new Reply()), "ExpectedHandlerFailure").then(()
        capture handler
        capture dispatcher
        handler.mode("reject")
        return expectFailure(invoke(dispatcher, 2, new Reply()), "ExpectedHandlerFailure")
    ).then(()
        capture handler
        capture dispatcher
        handler.mode("normal")
        return checkFailureReplay(dispatcher, handler)
    )

checkFailureReplay(dispatcher, handler)
    reply = new Reply()
    return invoke(dispatcher, 2, reply).then((result)
        capture dispatcher
        capture handler
        capture reply
        assertConflict(reply, "AlreadyConsumed")
        assert handler.calls.length == 2
        return invoke(dispatcher, 3, new Reply())
    ).then((result)
        capture handler
        assert handler.calls.length == 3
        println("PASS synchronous and asynchronous failures consume their sequence without blocking later events")
    )

checkPending()
    handler = new Handler()
    handler.blocking = true
    dispatcher = createDispatcher(new MemoryReplayStore(), handler)
    first = invoke(dispatcher, 1, new Reply())
    reply = new Reply()
    duplicate = invoke(dispatcher, 1, new Reply())
    next = invoke(dispatcher, 2, reply)
    return Promise/all([duplicate, next]).then((results)
        capture handler
        capture reply
        capture first
        assert handler.calls.length == 1
        assert results[0].reason == "AlreadyConsumed"
        assertConflict(reply, "InProgress")
        handler.pending.resolve({
            text: "completed"
        })
        return first
    ).then((result)
        capture dispatcher
        capture handler
        handler.mode("normal")
        return invoke(dispatcher, 2, new Reply())
    ).then((result)
        capture handler
        assert handler.calls.length == 2
        println("PASS atomic reservation rejects concurrent duplicates and keeps higher sequences retryable until completion")
    )

checkScopes()
    store = new MemoryReplayStore()
    handler = new Handler()
    first = createDispatcher(store, handler)
    second = createDispatcher(store, handler)
    return invoke(first, 1, new Reply()).then((result)
        capture second
        return invoke(second, 1, new Reply())
    ).then((result)
        capture second
        assert result.reason == "AlreadyConsumed"
        return invoke(second, 1, new Reply(), "replacement")
    ).then((result)
        capture first
        return invoke(first, 1, new Reply(), "instance", "another-session")
    ).then((result)
        capture first
        return invoke(first, 1, new Reply(), "instance", "session", "nested")
    ).then((result)
        capture handler
        assert handler.calls.length == 4
        println("PASS shared stores coordinate dispatchers while session, form and replacement instances remain independent")
    )

checkMutation()
    handler = new Handler()
    handler.mutate = true
    dispatcher = createDispatcher(new MemoryReplayStore(), handler)
    return invoke(dispatcher, 1, new Reply()).then((result)
        capture handler
        capture dispatcher
        handler.mode("normal")
        return invoke(dispatcher, 2, new Reply())
    ).then((result)
        capture handler
        assert handler.calls.length == 2
        println("PASS handler input mutation cannot change the reserved sequence released on completion")
    )

checkCapacity()
    store = new MemoryReplayStore(1)
    expiry = Date/now() / 1000 + 3600
    assert store.claim("first", 1, expiry) == "Accepted"
    store.complete("first", 1)
    assert store.claim("second", 1, expiry) == "Capacity"
    assert store.claim("first", 1, expiry) == "AlreadyConsumed"
    assert store.claim("first", 2, expiry) == "Accepted"
    store.complete("first", 2)
    assert store.claim("expired", 1, 1) == "Expired"
    original = host.Date.now
    frozen = ()
        capture expiry
        return (expiry + 1) * 1000
    replaceNow(frozen)
    try
        assert store.claim("second", 1, expiry + 3600) == "Accepted"
    finally
        replaceNow(original)
    println("PASS capacity never evicts live replay records and expired sessions cannot claim work")
    return null

replaceNow(callback)
    host.Date.now = callback

checkInvalidInput()
    handler = new Handler()
    dispatcher = createDispatcher(new MemoryReplayStore(), handler)
    reply = new Reply()
    invoke(dispatcher, 1, reply, "")
    assert reply.code == 400
    assert reply.body.error == "UiFormInstanceRequired"
    for [0, -1, 1.5, 9007199254740992] as seqno
        invalid = new Reply()
        invoke(dispatcher, seqno, invalid)
        assert invalid.code == 400
        assert invalid.body.error == "UiInvalidRequest"
    assert handler.calls.length == 0
    println("PASS malformed sequence and form instance fields fail before handler execution")
    return null

checkFullStore()
    handler = new Handler()
    dispatcher = createDispatcher(new MemoryReplayStore(1), handler)
    reply = new Reply()
    return invoke(dispatcher, 1, new Reply()).then((result)
        capture dispatcher
        capture reply
        return invoke(dispatcher, 1, reply, "another-instance")
    ).then((result)
        capture handler
        capture reply
        assert reply.code == 503
        assert reply.body.error == "UiReplayUnavailable"
        assert handler.calls.length == 1
        println("PASS a full replay store returns 503 without evicting protection or executing another handler")
    )

invokeWithState(dispatcher, store, reply)
    context state = store
    return invoke(dispatcher, 1, reply)

checkContextStore()
    store = new MemoryReplayStore()
    handler = new Handler()
    first = createDispatcher(null, handler)
    second = createDispatcher(null, handler)
    return invokeWithState(first, store, new Reply()).then((result)
        capture second
        capture store
        capture handler
        assert handler.observedState == store
        return invokeWithState(second, store, new Reply())
    ).then((result)
        capture handler
        capture store
        assert result.reason == "AlreadyConsumed"
        assert handler.calls.length == 1
        return checkCustomStore(store, handler)
    )

checkCustomStore(shared, handler)
    custom = createDispatcher(new MemoryReplayStore(), handler)
    return invokeWithState(custom, shared, new Reply()).then((result)
        capture handler
        assert result.seqno == 1
        assert handler.calls.length == 2
        println("PASS host context state coordinates default dispatchers while explicit replay adapters take precedence")
    )

class BrokenStore
    properties
        result
    methods
        claim(key, seqno, expiresAt)
        complete(key, seqno)

BrokenStore:claim(key, seqno, expiresAt)
    if @result == null
        return Promise/reject("ExpectedStoreFailure")
    return Promise/resolve(@result)

BrokenStore:complete(key, seqno)
    return null

checkInvalidStore()
    handler = new Handler()
    store = new BrokenStore()
    dispatcher = createDispatcher(store, handler)
    return expectFailure(invoke(dispatcher, 1, new Reply()), "ExpectedStoreFailure").then(()
        capture store
        capture dispatcher
        setStoreResult(store, "unexpected")
        return expectFailure(invoke(dispatcher, 1, new Reply()), "UiInvalidReplayStoreResult")
    ).then(()
        capture handler
        assert handler.calls.length == 0
        println("PASS replay store errors and unknown outcomes never run the handler")
    )

setStoreResult(store, result)
    store.result = result

expectFailure(pending, expected)
    return pending.then((result)
        throw "UnexpectedSuccess"
    ).catch((error)
        capture expected
        assert error == expected
    )
