import js global Promise
import js global Date
import "./library"
    class Dispatcher
import "./replay"
    class MemoryReplayStore

export main(args)

class Reply
    properties
        code
        body
        headers
    methods
        status(code)
        header(name, value)
        send(body)
        discardTokenChanges()

Reply()
    @code = 200
    @headers = {
    }

Reply:status(code)
    @code = code
    return @this

Reply:header(name, value)
    @headers[name] = value
    return @this

Reply:send(body)
    @body = body
    return body

Reply:discardTokenChanges()
    return null

class Handler
    properties
        calls
        blocking
        failing
        rejection
        mutate
        observedState
    methods
        handle(input)
        mode(mode)

Handler()
    @calls = []
    @blocking = false
    @failing = false
    @rejection = false
    @mutate = false

Handler:handle(input)
    @observedState = currentState()
    @calls.add(input.seqno)
    if @mutate
        input.seqno = 100
    if @failing
        throw "ExpectedHandlerFailure"
    if @rejection
        return Promise/reject("ExpectedHandlerFailure")
    if @blocking
        return Promise/resolve(null)
    return {
        text: "handled"
    }

currentState()
    context state
    try
        return state
    catch error
        return null

Handler:mode(mode)
    @failing = mode == "fail"
    @rejection = mode == "reject"
    @blocking = mode == "block"
    @mutate = mode == "mutate"
    return null

createDispatcher(store, handler)
    result = new Dispatcher(".", {
        replayStore: store
    })
    callback = (input)
        capture handler
        return handler.handle(input)
    result.event({
        path: "/save"
        function: callback
    })
    result.event({
        path: "/other"
        function: callback
    })
    return result

invoke(dispatcher, seqno, reply, instance = "instance", session = "session", form = "profile", path = "/save")
    context request = {
        id: "request"
        path: path
    }
    context response = reply
    context token = {
        sessionId: session
        sessionExpiresAt: Date/now() / 1000 + 3600
    }
    return dispatcher.handle({
        formId: form
        formInstanceId: instance
        seqno: seqno
        values: {
            text: "input"
        }
    })

main(args)
    checkCapacity()
    checkInvalidInput()
    checkDuplicates()
    checkFailures()
    checkPending()
    checkScopes()
    checkMutation()
    checkInvalidStore()
    checkFullStore()
    checkContextStore()

checkDuplicates()
    handler = new Handler()
    dispatcher = createDispatcher(new MemoryReplayStore(), handler)
    invoke(dispatcher, 1, new Reply())
    reply = new Reply()
    invoke(dispatcher, 1, reply)
    assertConflict(reply, "AlreadyConsumed")
    assert handler.calls.length == 1
    assert invoke(dispatcher, 3, new Reply()).seqno == 3
    stale = new Reply()
    invoke(dispatcher, 2, stale)
    assertConflict(stale, "AlreadyConsumed")
    other = new Reply()
    invoke(dispatcher, 3, other, "instance", "session", "profile", "/other")
    assertConflict(other, "AlreadyConsumed")
    assert handler.calls.length == 2
    println("PASS duplicate and older sequences are rejected across routes; gaps remain allowed")

assertConflict(reply, reason)
    assert reply.code == 409
    assert reply.body.error == "UiReplayConflict"
    assert reply.body.reason == reason
    assert reply.headers["Cache-Control"] == "no-store"

checkFailures()
    handler = new Handler()
    dispatcher = createDispatcher(new MemoryReplayStore(), handler)
    for ["fail", "reject", "block"] as index: mode
        handler.mode(mode)
        expected = "UiSynchronousResultRequired"
        if mode == "fail"
            expected = "ExpectedHandlerFailure"
        expectFailure(dispatcher, index + 1, expected)
        reply = new Reply()
        invoke(dispatcher, index + 1, reply)
        assertConflict(reply, "AlreadyConsumed")
    handler.mode("normal")
    invoke(dispatcher, 4, new Reply())
    assert handler.calls.length == 4
    println("PASS handler exceptions and forbidden Promise results consume their sequence and release reservations")

checkPending()
    store = new MemoryReplayStore()
    handler = new Handler()
    dispatcher = createDispatcher(store, handler)
    key = to_json(["session", "profile", "instance"])
    assert store.claim(key, 1, Date/now() / 1000 + 3600) == "Accepted"
    duplicate = new Reply()
    invoke(dispatcher, 1, duplicate)
    assertConflict(duplicate, "AlreadyConsumed")
    next = new Reply()
    invoke(dispatcher, 2, next)
    assertConflict(next, "InProgress")
    assert handler.calls.length == 0
    store.complete(key, 1)
    invoke(dispatcher, 2, new Reply())
    assert handler.calls.length == 1
    println("PASS another request's reservation rejects duplicates and keeps higher sequences retryable until completion")

checkScopes()
    store = new MemoryReplayStore()
    handler = new Handler()
    first = createDispatcher(store, handler)
    second = createDispatcher(store, handler)
    invoke(first, 1, new Reply())
    result = invoke(second, 1, new Reply())
    assert result.reason == "AlreadyConsumed"
    invoke(second, 1, new Reply(), "replacement")
    invoke(first, 1, new Reply(), "instance", "another-session")
    invoke(first, 1, new Reply(), "instance", "session", "nested")
    assert handler.calls.length == 4
    println("PASS shared stores coordinate dispatchers while session, form and replacement instances remain independent")

checkMutation()
    handler = new Handler()
    handler.mode("mutate")
    dispatcher = createDispatcher(new MemoryReplayStore(), handler)
    invoke(dispatcher, 1, new Reply())
    handler.mode("normal")
    invoke(dispatcher, 2, new Reply())
    assert handler.calls.length == 2
    println("PASS input mutation cannot change the reserved sequence released on completion")

checkCapacity()
    special = new MemoryReplayStore(4)
    expiry = Date/now() / 1000 + 3600
    for ["__proto__", "constructor", "prototype", "toString"] as key
        assert special.claim(key, 1, expiry) == "Accepted"
        special.complete(key, 1)
        assert special.claim(key, 1, expiry) == "AlreadyConsumed"
    assert special.claim("extra", 1, expiry) == "Capacity"
    store = new MemoryReplayStore(1)
    assert store.claim("first", 1, expiry) == "Accepted"
    store.complete("first", 1)
    assert store.claim("second", 1, expiry) == "Capacity"
    assert store.claim("first", 1, expiry) == "AlreadyConsumed"
    assert store.claim("first", 2, expiry) == "Accepted"
    store.complete("first", 2)
    assert store.claim("expired", 1, 1) == "Expired"
    original = Date.now
    frozen = ()
        capture expiry
        return (expiry + 1) * 1000
    replaceNow(frozen)
    try
        assert store.claim("second", 1, expiry + 3600) == "Accepted"
    finally
        replaceNow(original)
    println("PASS capacity never evicts live replay records and expired sessions cannot claim work")
    return null

replaceNow(callback)
    Date.now = callback

checkInvalidInput()
    handler = new Handler()
    dispatcher = createDispatcher(new MemoryReplayStore(), handler)
    reply = new Reply()
    invoke(dispatcher, 1, reply, "")
    assert reply.code == 400
    assert reply.body.error == "UiFormInstanceRequired"
    for [0, -1, 1.5, 9007199254740992] as seqno
        invalid = new Reply()
        invoke(dispatcher, seqno, invalid)
        assert invalid.code == 400
        assert invalid.body.error == "UiInvalidRequest"
    assert handler.calls.length == 0
    println("PASS malformed sequence and form instance fields fail before handler execution")
    return null

checkFullStore()
    handler = new Handler()
    dispatcher = createDispatcher(new MemoryReplayStore(1), handler)
    invoke(dispatcher, 1, new Reply())
    reply = new Reply()
    invoke(dispatcher, 1, reply, "another-instance")
    assert reply.code == 503
    assert reply.body.error == "UiReplayUnavailable"
    assert handler.calls.length == 1
    println("PASS a full replay store returns 503 without evicting protection or executing handlers")

invokeWithState(dispatcher, store, reply)
    context state = store
    return invoke(dispatcher, 1, reply)

checkContextStore()
    store = new MemoryReplayStore()
    handler = new Handler()
    first = createDispatcher(null, handler)
    second = createDispatcher(null, handler)
    invokeWithState(first, store, new Reply())
    assert handler.observedState == store
    duplicate = invokeWithState(second, store, new Reply())
    assert duplicate.reason == "AlreadyConsumed"
    custom = createDispatcher(new MemoryReplayStore(), handler)
    invokeWithState(custom, store, new Reply())
    assert handler.calls.length == 2
    println("PASS context state coordinates default dispatchers while explicit stores take precedence")

class BrokenStore
    properties
        result
    methods
        claim(key, seqno, expiresAt)
        complete(key, seqno)

BrokenStore:claim(key, seqno, expiresAt)
    if @result == null
        throw "ExpectedStoreFailure"
    return @result

BrokenStore:complete(key, seqno)
    return null

checkInvalidStore()
    handler = new Handler()
    store = new BrokenStore()
    dispatcher = createDispatcher(store, handler)
    expectFailure(dispatcher, 1, "ExpectedStoreFailure")
    store.result = "unexpected"
    expectFailure(dispatcher, 1, "UiInvalidReplayStoreResult")
    assert handler.calls.length == 0
    println("PASS replay store errors and unknown outcomes never run handlers")

expectFailure(dispatcher, seqno, expected)
    failed = false
    try
        invoke(dispatcher, seqno, new Reply())
    catch error
        assert error == expected
        failed = true
    assert failed
