import js global Reflect
import js global Date

export class MemoryReplayStore
    methods
        claim(key, seqno, expiresAt)
        complete(key, seqno)

MemoryReplayStore(maxForms = 10000)
    if !is_number(maxForms) or maxForms < 1 or maxForms % 1 != 0
        throw "UiReplayCapacityMustBePositive"
    @maxForms = maxForms
    @forms = {
    }
    @size = 0

MemoryReplayStore:claim(key, seqno, expiresAt)
    now = Date/now() / 1000
    if !is_number(expiresAt) or expiresAt <= now
        return "Expired"
    key = "form:${key}"
    previous = @forms[key]
    if previous != null and previous.expiresAt <= now
        Reflect/deleteProperty(@forms, key)
        @size = @size - 1
        previous = null
    if previous != null
        if seqno <= previous.seqno
            return "AlreadyConsumed"
        if previous.pending
            return "InProgress"
    if previous == null and @size >= @maxForms
        for @forms as name: record
            if record.expiresAt <= now
                Reflect/deleteProperty(@forms, name)
                @size = @size - 1
        if @size >= @maxForms
            return "Capacity"
    if previous == null
        @size++
    @forms[key] = {
        seqno: seqno
        expiresAt: expiresAt
        pending: true
    }
    return "Accepted"

MemoryReplayStore:complete(key, seqno)
    key = "form:${key}"
    record = @forms[key]
    if record == null
        return null
    if record.seqno != seqno
        throw "UiReplayReservationLost"
    record.pending = false
    return null
