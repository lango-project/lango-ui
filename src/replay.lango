import js global Map
import js global Array
import js global Date

export class MemoryReplayStore
    methods
        claim(key, seqno, expiresAt)
        complete(key, seqno)

MemoryReplayStore(maxForms = 10000)
    if !is_number(maxForms) or maxForms < 1 or maxForms % 1 != 0
        throw "UiReplayCapacityMustBePositive"
    @maxForms = maxForms
    @forms = new Map()

MemoryReplayStore:claim(key, seqno, expiresAt)
    now = Date/now() / 1000
    if !is_number(expiresAt) or expiresAt <= now
        return "Expired"
    previous = @forms.get(key)
    if previous != null and previous.expiresAt <= now
        @forms.delete(key)
        previous = null
    if previous != null
        if seqno <= previous.seqno
            return "AlreadyConsumed"
        if previous.pending
            return "InProgress"
    if previous == null and @forms.size >= @maxForms
        entries = Array/from(@forms.entries())
        for entries as entry
            record = entry[1]
            if record.expiresAt <= now
                @forms.delete(entry[0])
        if @forms.size >= @maxForms
            return "Capacity"
    @forms.set(key, {
        seqno: seqno
        expiresAt: expiresAt
        pending: true
    })
    return "Accepted"

MemoryReplayStore:complete(key, seqno)
    record = @forms.get(key)
    if record == null
        return null
    if record.seqno != seqno
        throw "UiReplayReservationLost"
    record.pending = false
    return null
