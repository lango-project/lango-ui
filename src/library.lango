import js "node:fs" as fs
import js "node:module" as nodeModule
import js "node:path" as path
import js "node:util" as util
import js global Promise
import js global URL
import "./input_values"
    selectItems(options)
    selectIndex(items, value)
import "./validation"
    rulesFor(value)
import "./replay"
    class MemoryReplayStore
import "./event_form"
    createForm(values, changes, commands)
    validateNames(values)

export protocolVersion()

protocolVersion()
    return 1

export class Dispatcher
    methods
        event(options)
        routesFromXml(file)
        preload()
        handle(input)
        dispatch(route, input)
        protectedEvent(route, input, identity)
        reservedEvent(route, input, key, outcome, store)

Dispatcher(appRoot, options = null)
    @appRoot = appRoot
    @routes = []
    @replay = null
    @preloaded = false
    @preloadRequested = false
    @loading = null
    @needsPreload = false
    if options != null
        @replay = options.replayStore
        if options.synchronous == false
            throw "UiAsyncDispatchRemoved"
    @customReplay = @replay != null
    if @replay == null
        @replay = new MemoryReplayStore()
    if !is_kindof(@replay.claim, Function) or !is_kindof(@replay.complete, Function)
        throw "UiReplayStoreRequired"

Dispatcher:event(options)
    if @preloaded or @loading != null
        throw "UiRegistryAlreadyLoadingOrPreloaded"
    if !is_object(options) or !is_string(options.path) or options.path[0] != "/"
        throw "UiEventRequiresAbsolutePath"
    handler = options.function
    module = options.module
    if !is_kindof(handler, Function)
        if !is_string(handler) or handler == ""
            throw "UiEventRequiresFunction"
        if module == null or (is_string(module) and module == "")
            throw "UiEventRequiresModule"
    for @routes as route
        if route.path == options.path
            throw "UiDuplicateEventPath: ${options.path}"
    if is_string(module) and is_string(handler)
        @needsPreload = true
    @routes.add({
        path: options.path
        module: module
        function: handler
    })
    return @this

Dispatcher:preload()
    if @preloaded
        return Promise/resolve(@this)
    if @loading != null
        return @loading
    @preloadRequested = true
    @loading = prepare()
    return @loading

Dispatcher:prepare()
    return Promise/resolve().then(()
        return prepareEvents(@appRoot, @routes, 0, [], {
        })
    ).then((routes)
        @routes = routes
        @needsPreload = false
        @preloaded = true
        return @this
    ).finally(()
        @loading = null
    )

prepareEvents(appRoot, routes, index, prepared, cache)
    if index == routes.length
        return Promise/resolve(prepared)
    route = routes[index]
    if is_kindof(route.function, Function) or !is_string(route.module)
        prepared.add(preparedEvent(route, route.module))
        return prepareEvents(appRoot, routes, index + 1, prepared, cache)
    resolver = nodeModule/createRequire(path.join(appRoot, "package.json"))
    file = resolver.resolve(route.module)
    if file in cache
        prepared.add(preparedEvent(route, cache[file]))
        return prepareEvents(appRoot, routes, index + 1, prepared, cache)
    return import_module(file).then((module)
        capture route
        capture appRoot
        capture routes
        capture index
        capture prepared
        capture cache
        capture file
        cache[file] = module
        prepared.add(preparedEvent(route, module))
        return prepareEvents(appRoot, routes, index + 1, prepared, cache)
    )

preparedEvent(route, module)
    handler = route.function
    if is_string(handler)
        if !is_object(module) or !is_kindof(module[handler], Function)
            throw "UiHandlerNotExported: ${route.path} -> ${handler}"
        handler = module[handler]
    return {
        path: route.path
        module: null
        function: handler
    }

Dispatcher:routesFromXml(file)
    root = xml2obj(fs.readFileSync(file, "utf8"))
    if root.tag() != "ui"
        throw "UiConfigRootMustBeUi"
    for root.children() as tag
        if tag.tag() != "event"
            throw "UiConfigRequiresEvent"
        event({
            path: tag.path
            module: tag.mod
            function: tag.func
        })
    return @this

Dispatcher:handle(input)
    if @loading != null or (@preloadRequested and !@preloaded) or @needsPreload
        throw "UiDispatcherNotPreloaded"
    context request
    context response
    context token
    context log
    identity = eventIdentity()
    if is_object(input) and "protocol" in input
        if input.protocol != protocolVersion()
            if identity != null
                return eventFailure(400, "UiProtocolUnsupported", "Expected protocol 1")
            throw "UiProtocolUnsupported"
    error = eventInputError(input)
    if error != null
        if identity != null
            return eventFailure(400, "UiInvalidRequest", error)
        throw error
    routes = @routes
    for routes as route
        if route.path == request.path
            if identity != null
                return protectedEvent(route, input, identity)
            return dispatch(route, input)
    throw "UiEventNotFound"

eventInputError(input)
    if !is_object(input)
        return "UiRequestMustBeMap"
    if !is_object(input.values)
        return "UiRequestRequiresValues"
    if !is_string(input.formId) or input.formId == ""
        return "UiRequestRequiresFormId"
    if !is_number(input.seqno) or input.seqno < 1 or input.seqno > 9007199254740991 or input.seqno % 1 != 0
        return "UiRequestRequiresSequenceNumber"
    return null

eventIdentity()
    context token
    claims = null
    try
        claims = token
    catch error
        return null
    if !is_object(claims) or claims.sessionId == null
        return null
    if !is_string(claims.sessionId) or claims.sessionId == "" or !is_number(claims.sessionExpiresAt)
        throw "UiVerifiedSessionRequired"
    return {
        sessionId: claims.sessionId
        expiresAt: claims.sessionExpiresAt
    }

requestState()
    context state
    store = null
    try
        store = state
    catch error
        return null
    if store != null
        if !is_kindof(store.claim, Function) or !is_kindof(store.complete, Function)
            throw "UiReplayStoreRequired"
    return store

Dispatcher:reservedEvent(route, input, key, outcome, store)
    context request
    context response
    context token
    context log
    context state
    switch outcome
      case "AlreadyConsumed"
      case "InProgress"
          return eventFailure(409, "UiReplayConflict", outcome)
      case "Capacity"
          return eventFailure(503, "UiReplayUnavailable", outcome)
      case "Expired"
          return eventFailure(401, "Unauthorized", null)
      else
          throw "UiInvalidReplayStoreResult"

eventFailure(status, error, reason)
    context request
    context response
    response.discardTokenChanges()
    response.header("Cache-Control", "no-store")
    if status == 401
        response.header("WWW-Authenticate", "Bearer")
    return response.status(status).send({
        protocol: protocolVersion()
        error: error
        reason: reason
        requestId: request.id
    })

Dispatcher:dispatch(route, input)
    context request
    context response
    context token
    context log
    context state = requestState()
    handler = route.function
    if is_string(handler)
        if route.module == null or is_string(route.module)
            throw "UiDispatcherNotPreloaded"
        mod = route.module
        handler = mod[handler]
    if !is_kindof(handler, Function)
        throw "UiEventRequiresFunction"
    return invokeEvent({
        handler: handler
    }, input)

invokeEvent(route, input)
    changes = {
    }
    commands = []
    context form = createForm(input.values, changes, commands)
    result = synchronousValue(route.handler(input))
    return eventResult(input, changes, commands, result)

synchronousValue(value)
    if util/types/isPromise(value)
        value.catch((error)
            return null
        )
        throw "UiSynchronousResultRequired"
    if value != null
        if is_kindof(value.then, Function)
            throw "UiSynchronousResultRequired"
    return value

Dispatcher:protectedEvent(route, input, identity)
    instance = input.formInstanceId
    if !is_string(instance) or instance == "" or instance.length > 128
        return eventFailure(400, "UiFormInstanceRequired", null)
    key = to_json([identity.sessionId, input.formId, instance])
    store = @replay
    shared = requestState()
    context state = shared
    if !@customReplay and shared != null
        store = shared
    outcome = synchronousValue(store.claim(key, input.seqno, identity.expiresAt))
    if outcome == "Accepted"
        seqno = input.seqno
        try
            return dispatch(route, input)
        finally
            synchronousValue(store.complete(key, seqno))
    return reservedEvent(route, input, key, outcome, store)

mergeValues(target, source)
    for source as name: value
        if is_object(value) and name in target
            if is_object(target[name])
                mergeValues(target[name], value)
              else
                  target[name] = value
          else
              target[name] = value
    return target

eventResult(input, changes, commands, values)
    if values != null
        if not is_object(values)
            throw "UiHandlerMustReturnValuesMap"
        validateNames(values)
        mergeValues(changes, values)
    return {
        protocol: protocolVersion()
        formId: input.formId
        seqno: input.seqno
        ui: {
            replace: {
            }
            remove: []
        }
        vals: changes
        cmds: commands
    }

export class Response
    methods
        replace(target, control)
        remove(target)
        value(name, value)
        command(command)
        setEnabled(target, value)
        setVisible(target, value)
        setProperty(target, name, value)
        focus(target)
        toast(level, text)
        result()
        markClean(target, value)
        fieldError(target, message)

export class Control
    properties
        name
        type
        enabled
        visible
        value
        events
        classes
        style
        validation
        trackChanges
    methods
        setValue(value)
        getValue()
        definition()

export class Container : Control
    properties
        controls
    methods
        add(control)
        get(name)
        definition()

export class Form : Container
    properties
        inherit
    methods
        definition()

export class Button : Control
    properties
        text
        event
        validate
        confirmDirty
    methods
        definition()

export class Value : Control

export class Select : Control
    properties
        options
        event
        label
    methods
        definition()

export class Checkbox : Control
    properties
        event
        label
    methods
        definition()

Select(options)
    super(inputName(options, "Select"), "Select")
    configureValidation(@this, options)
    @options = selectItems(options.options)
    selectIndex(@options, options.value)
    @value = options.value
    @label = options.label
    @event = options.event
    if options.events != null
        @events = options.events

Select:definition()
    items = selectItems(@options)
    selectIndex(items, @value)
    result = super.definition()
    result.options = items
    result.event = @event
    result.label = @label
    return result

Checkbox(options)
    super(inputName(options, "Checkbox"), "Checkbox")
    configureValidation(@this, options)
    value = options.value
    if value == null
        value = false
    if !is_bool(value)
        throw "UiCheckboxValueMustBeBoolean"
    @value = value
    @label = options.label
    @event = options.event
    if options.events != null
        @events = options.events

Checkbox:definition()
    if !is_bool(@value)
        throw "UiCheckboxValueMustBeBoolean"
    result = super.definition()
    result.event = @event
    result.label = @label
    return result

inputName(options, type)
    if !is_object(options) or is_array(options)
        throw "Ui${type}RequiresMap"
    return options.name

configureValidation(control, options)
    if options.validation != null
        control.validation = rulesFor(options.validation)
    if options.trackChanges != null
        control.trackChanges = trackingValue(options.trackChanges)

trackingValue(value)
    if value != null and !is_bool(value)
        throw "UiTrackChangesMustBeBoolean"
    return value

Value(name, value)
    super(name, "Value")
    @value = value

Control(name, type)
    if !is_string(type) or type == ""
        throw "UiControlRequiresType"
    @name = name
    @type = type
    @enabled = true
    @visible = true
    @value = null
    @events = {
    }
    @classes = []
    @style = {
    }
    @validation = null
    @trackChanges = null

Control:setValue(value)
    @value = value
    return @this

Control:getValue()
    return @value

Control:definition()
    return {
        type: @type
        name: @name
        enabled: @enabled
        visible: @visible
        value: @value
        events: @events
        classes: @classes
        style: @style
        validation: rulesFor(@validation)
        trackChanges: trackingValue(@trackChanges)
    }

Container(name = null, type = "Container")
    super(name, type)
    @controls = []
    @controlsByName = {
    }

Container:add(control)
    if not is_kindof(control, Control)
        throw "UiContainerRequiresControl"
    controlsByName = @controlsByName
    if control.name != null and control.name != ""
        if control.name in @this
            throw "UiDuplicateOrReservedControlName: ${control.name}"
    controls = @controls
    controls[controls.length] = control
    if control.name != null and control.name != ""
        controlsByName[control.name] = control
        @this[control.name] = control
    return control

Container:get(name)
    return @controlsByName[name]

Container:definition()
    controls = @controls
    definitions = []
    for controls as control
        definitions[definitions.length] = control.definition()
    return {
        type: @type
        name: @name
        controls: definitions
        enabled: @enabled
        visible: @visible
        events: @events
        classes: @classes
        style: @style
        validation: rulesFor(@validation)
        trackChanges: trackingValue(@trackChanges)
    }

Form(formId)
    super(formId, "Form")
    @formId = formId
    @inherit = {
    }

Form:definition()
    if !is_object(@inherit)
        throw "UiInheritanceMustBeMap"
    result = super.definition()
    result.inherit = @inherit
    return result

buttonName(options)
    if is_object(options)
        return options.name
    return options

Button(options)
    super(buttonName(options), "Button")
    @validate = false
    @confirmDirty = false
    if is_object(options)
        configureValidation(@this, options)
        @text = options.text
        @event = options.event
        if options.validate != null
            @validate = options.validate
        if options.confirmDirty != null
            @confirmDirty = options.confirmDirty
        if options.events != null
            @events = options.events

Button:definition()
    if !is_bool(@validate)
        throw "UiValidateEventMustBeBoolean"
    if !is_bool(@confirmDirty)
        throw "UiConfirmDirtyMustBeBoolean"
    result = super.definition()
    result.text = @text
    result.event = @event
    result.validate = @validate
    result.confirmDirty = @confirmDirty
    return result

Response:markClean(target, value)
    return setProperty(target, "savedValue", value)

Response:fieldError(target, message)
    if message != null and !is_string(message)
        throw "UiFieldErrorMustBeStringOrNull"
    return setProperty(target, "error", message)

Response(formId, seqno)
    if !is_string(formId) or formId == ""
        throw "UiResponseRequiresFormId"
    if !is_number(seqno) or seqno < 0 or seqno % 1 != 0
        throw "UiResponseRequiresSequenceNumber"
    @formId = formId
    @seqno = seqno
    @replace = {
    }
    @remove = []
    @vals = {
    }
    @cmds = []

Response:replace(target, control)
    path = patchPath(target)
    if not is_object(control)
        throw "UiReplaceRequiresControlMap"
    current = @replace
    for path as index: name
        if is_string(current.type)
            throw "UiOverlappingStructurePatches"
        if index == path.length - 1
            if name in current
                if not is_string(current[name].type)
                    throw "UiOverlappingStructurePatches"
            current[name] = control
          else
              if not (name in current)
                  current[name] = {
                  }
              current = current[name]
    return @this

Response:remove(target)
    path = patchPath(target)
    for @remove as existing
        existingPath = patchPath(existing)
        if to_json(existingPath) == to_json(path)
            return @this
    @remove.add(target)
    return @this

patchPath(target)
    path = target
    if is_string(target)
        path = [target]
    if !is_array(path) or path.length == 0
        throw "UiPatchRequiresTarget"
    for path as name
        if !is_string(name) or name == "" or name == "__proto__" or name == "constructor" or name == "prototype"
            throw "UiPatchRequiresValidTargetName"
    return path

Response:value(name, value)
    if !is_string(name) or name == ""
        throw "UiValueRequiresName"
    @vals[name] = value
    return @this

Response:command(command)
    if !is_object(command) or !is_string(command.type) or command.type == ""
        throw "UiCommandRequiresType"
    @cmds.add(command)
    return @this

Response:setEnabled(target, value)
    if not is_bool(value)
        throw "UiSetEnabledRequiresBoolean"
    return command({
        type: "setEnabled"
        target: target
        value: value
    })

Response:setVisible(target, value)
    if not is_bool(value)
        throw "UiSetVisibleRequiresBoolean"
    return command({
        type: "setVisible"
        target: target
        value: value
    })

Response:setProperty(target, name, value)
    return command({
        type: "setProperty"
        target: target
        name: name
        value: value
    })

Response:focus(target)
    return command({
        type: "focus"
        target: target
    })

Response:toast(level, text)
    return command({
        type: "toast"
        level: level
        text: text
    })

Response:result()
    replacements = @replace
    removed = @remove
    values = @vals
    commands = @cmds
    return {
        protocol: protocolVersion()
        formId: @formId
        seqno: @seqno
        ui: {
            replace: replacements
            remove: removed
        }
        vals: values
        cmds: commands
    }

test "responses keep values separate from commands"
    response = new Response("profile", 12)
    response.replace("address", {
        type: "Panel"
        controls: []
    })
    response.value("email", "ada@example.com")
    response.setEnabled("saveButton", false)
    response.focus("email")
    result = response.result()
    assert result.formId == "profile"
    assert result.seqno == 12
    assert result.vals.email == "ada@example.com"
    assert result.cmds[0].type == "setEnabled"
    assert result.cmds[1].type == "focus"

test "responses deduplicate removed controls"
    response = new Response("profile", 0)
    response.remove("warning")
    response.remove("warning")
    result = response.result()
    assert result.ui.remove.length == 1

test "response patches preserve hierarchical paths"
    response = new Response("profile", 1)
    response.replace(["address", "city"], {
        type: "Text"
        value: "Ankara"
    })
    response.remove(["address", "warning"])
    response.remove(["address", "warning"])
    result = response.result()
    assert result.ui.replace.address.city.type == "Text"
    assert result.ui.remove.length == 1
    assert result.ui.remove[0][1] == "warning"

test "forms expose uniquely named controls as properties"
    form = new Form("profile")
    form.add(new Button("saveButton"))
    form.saveButton.enabled = false
    assert form.saveButton.enabled == false
    assert form.get("saveButton") == form.saveButton

test "form definitions carry explicit inherited-value declarations"
    form = new Form("details")
    form.inherit = {
        customerId: "customerId"
        city: {
            path: ["address", "city"]
            writable: true
        }
    }
    definition = form.definition()
    assert definition.inherit.customerId == "customerId"
    assert definition.inherit.city.path[1] == "city"
    assert definition.inherit.city.writable
    assert definition.controls.length == 0

test "forms reject duplicate control names"
    form = new Form("profile")
    form.add(new Button("saveButton"))
    try
        form.add(new Button("saveButton"))
        assert false
    catch error
        assert error == "UiDuplicateOrReservedControlName: saveButton"

test "UI events turn hierarchical form writes into values and commands"
    result = runProfileEvent()
    assert result.vals.address.city == "Istanbul"
    assert result.cmds[0].target[0] == "saveButton"
    assert result.cmds[0].name == "enabled"
    assert result.cmds[0].value == false

test "unnamed containers and names in separate containers are supported"
    container = new Container()
    first = new Container("first")
    second = new Container("second")
    first.add(new Button({
        name: "save"
        text: "Save"
        event: "/save"
    }))
    second.add(new Button("save"))
    container.add(first)
    container.add(second)
    definition = container.definition()
    assert definition.controls.length == 2
    assert first.save.text == "Save"

test "unavailable form state fails explicitly"
    changes = {
    }
    commands = []
    form = createForm({
        button: null
    }, changes, commands)
    try
        enabled = form.button.enabled
        assert false
    catch error
        assert error == "UiFormPropertyUnavailable: enabled"

runProfileEvent()
    context request = {
        path: "/app/save"
    }
    dispatcher = new Dispatcher("/tmp")
    dispatcher.event({
        path: "/app/save"
        function: editProfile
    })
    return dispatcher.handle({
        formId: "profile"
        seqno: 1
        values: {
            address: {
                city: "Ankara"
            }
            saveButton: null
        }
    })

editProfile(input)
    context form
    assert form.address.city.value == "Ankara"
    form.saveButton.enabled = false
    form.address.city.value = "Izmir"
    return {
        address: {
            city: "Istanbul"
        }
    }

export class Pages
    methods
        template(options)
        page(options)
        routesFromXml(file)
        preload()
        match(url)
        render(options)

Pages(appRoot = ".")
    @appRoot = path.resolve(appRoot)
    @preloadRequested = false
    @templates = []
    @pages = []
    @loading = null
    @preloaded = false
    @needsPreload = false
    @sealed = false

Pages:template(options)
    registerPageRoute(options, true)
    return @this

Pages:page(options)
    registerPageRoute(options, false)
    return @this

Pages:registerPageRoute(options, template)
    if @sealed or @loading != null or @preloaded
        throw "UiPageRegistrySealed"
    if !is_object(options)
        throw "UiPageRouteRequiresMap"
    routePath = options.path
    if !is_string(routePath) or pagePath(routePath) != routePath or routePath.includes("*")
        throw "UiPageRouteRequiresPath"
    if template and !routePath.endsWith("/")
        throw "UiTemplateRequiresTrailingSlash"
    handler = options.function
    module = options.module
    if !is_kindof(handler, Function)
        if !is_string(handler) or handler == "" or module == null or module == ""
            throw "UiPageRouteRequiresFunction"
    routes = @pages
    if template
        routes = @templates
    for routes as route
        if route.path == routePath
            throw "UiDuplicatePageRoute: ${routePath}"
    if is_string(module) and is_string(handler)
        @needsPreload = true
    routes.add({
        path: routePath
        module: module
        function: handler
    })

Pages:routesFromXml(file)
    root = xml2obj(fs.readFileSync(file, "utf8"))
    if root.tag() != "ui"
        throw "UiConfigRootMustBeUi"
    for root.children() as tag
        kind = tag.tag()
        if kind != "template" and kind != "page"
            throw "UiPageConfigRequiresTemplateOrPage"
        for tag.attributes() as name: value
            if name != "path" and name != "mod" and name != "func"
                throw "UiPageConfigUnknownAttribute: ${name}"
        if tag.children().length != 0 or tag.innerText().trim() != ""
            throw "UiPageConfigRouteMustBeEmpty"
        registerPageRoute({
            path: tag.path
            module: tag.mod
            function: tag.func
        }, kind == "template")
    return @this

Pages:preload()
    if @preloaded
        return Promise/resolve(@this)
    if @loading != null
        return @loading
    @sealed = true
    @preloadRequested = true
    @loading = preparePages()
    return @loading

Pages:preparePages()
    return Promise/resolve().then(()
        return prepareEventsForPages()
    ).finally(()
        @loading = null
    )

Pages:prepareEventsForPages()
    cache = {
    }
    return prepareEvents(@appRoot, @templates, 0, [], cache).then((templates)
        capture cache
        @templates = templates
        return prepareEvents(@appRoot, @pages, 0, [], cache)
    ).then((pages)
        @pages = pages
        @needsPreload = false
        @preloaded = true
        return @this
    )

Pages:match(url)
    @sealed = true
    pathname = pagePath(url)
    selected = null
    for @pages as route
        if route.path == pathname
            selected = route
            break
    if selected == null
        return null
    template = null
    for @templates as route
        if pathname.startsWith(route.path)
            if template == null or route.path.length > template.path.length
                template = route
    if template == null
        throw "UiPageTemplateNotFound: ${pathname}"
    return {
        url: url
        pathname: pathname
        template: template.path
        page: selected.path
    }

Pages:render(options)
    if !is_object(options)
        throw "UiPageRenderRequiresMap"
    if @loading != null or @needsPreload or (@preloadRequested and !@preloaded)
        throw "UiPageRegistryNotPreloaded"
    selected = match(options.url)
    if selected == null
        throw "UiPageNotFound"
    pageRoute = pageRouteAt(@pages, selected.page)
    page = null
    if options.template == selected.template
        page = pageDefinition(pageRoute, selected)
        page.name = "__content__"
        return {
            template: selected.template
            target: ["content", "__content__"]
            control: page
        }
    templateRoute = pageRouteAt(@templates, selected.template)
    template = pageDefinition(templateRoute, selected)
    if template.type != "Container" or !is_array(template.controls)
        throw "UiPageTemplateRequiresContainer"
    slot = -1
    for template.controls as index: control
        if control.name == "__content__"
            if slot != -1 or control.type != "Container"
                throw "UiPageTemplateRequiresContentSlot"
            slot = index
    if slot == -1
        throw "UiPageTemplateRequiresContentSlot"
    page = pageDefinition(pageRoute, selected)
    page.name = "__content__"
    template.controls[slot] = page
    template.name = "content"
    return {
        template: selected.template
        target: "content"
        control: template
    }

pagePath(url)
    if !is_string(url) or !url.startsWith("/") or url.startsWith("//") or url.includes("\\") or url.trim() != url
        throw "UiPageRequiresLocalUrl"
    parsed = new URL(url, "http://lango.invalid")
    if parsed.origin != "http://lango.invalid"
        throw "UiPageRequiresLocalUrl"
    return parsed.pathname

pageRouteAt(routes, path)
    for routes as route
        if route.path == path
            return route
    throw "UiPageNotFound"

pageDefinition(route, selected)
    handler = route.function
    if is_string(handler)
        module = route.module
        if module == null or is_string(module)
            throw "UiPageRegistryNotPreloaded"
        handler = module[handler]
    if !is_kindof(handler, Function)
        throw "UiPageRouteRequiresFunction"
    value = synchronousValue(handler(selected))
    if !is_object(value) or !is_string(value.type)
        throw "UiPageRequiresControlDefinition"
    return from_json(to_json(value))

test "control builders retain CSS classes and styles outside values"
    form = new Form("profile")
    form.classes = ["profile"]
    form.style = {
        "--accent": "navy"
    }
    button = form.add(new Button("save"))
    button.classes = ["primary"]
    button.style = {
        "background-color": "navy"
    }
    definition = form.definition()
    assert definition.classes[0] == "profile"
    assert definition.style["--accent"] == "navy"
    assert definition.controls[0].classes[0] == "primary"
    assert definition.controls[0].style["background-color"] == "navy"
    assert definition.controls[0].value == null

test "Select and Checkbox builders preserve typed values, options and accessible names"
    form = new Form("preferences")
    country = form.add(new Select({
        name: "country"
        label: "Country"
        value: ""
        event: "/save"
        options: [{
            value: ""
            text: "Empty code"
        }, {
            value: "archive"
            text: "Archived"
            disabled: true
        }]
    }))
    subscribed = form.add(new Checkbox({
        name: "subscribed"
        label: "Receive updates"
    }))
    definition = form.definition()
    assert definition.controls[0].type == "Select"
    assert definition.controls[0].value == ""
    assert definition.controls[0].options[1].disabled == true
    assert definition.controls[0].event == "/save"
    assert definition.controls[0].label == "Country"
    assert definition.controls[1].type == "Checkbox"
    assert definition.controls[1].value == false
    assert definition.controls[1].label == "Receive updates"
    country.value = null
    subscribed.value = true
    definition = form.definition()
    assert definition.controls[0].value == null
    assert definition.controls[1].value == true
    country.value = "unknown"
    failed = false
    try
        form.definition()
    catch error
        assert error == "UiSelectValueNotInOptions"
        failed = true
    assert failed
    country.value = null
    subscribed.value = "false"
    failed = false
    try
        form.definition()
    catch error
        assert error == "UiCheckboxValueMustBeBoolean"
        failed = true
    assert failed

test "validation metadata, save acknowledgements and field errors stay outside values"
    form = new Form("profile")
    field = form.add(new Control("email", "Text"))
    field.validation = {
        required: true
        maxLength: 254
        pattern: "[^ @]+@[^ @]+[.][^ @]+"
    }
    field.trackChanges = true
    save = form.add(new Button({
        name: "save"
        validate: true
        confirmDirty: true
    }))
    checkbox = new Checkbox({
        name: "agreed"
        validation: {
            required: true
        }
        trackChanges: false
    })
    checkedDefinition = checkbox.definition()
    assert checkedDefinition.validation.required == true
    assert checkedDefinition.trackChanges == false
    definition = form.definition()
    assert definition.controls[0].validation.required == true
    assert definition.controls[0].trackChanges == true
    assert definition.controls[1].validate == true
    assert definition.controls[1].confirmDirty == true
    response = new Response("profile", 1)
    response.markClean("email", "saved@example.com")
    response.fieldError("email", "Unavailable")
    result = response.result()
    assert result.cmds[0].name == "savedValue"
    assert result.cmds[0].value == "saved@example.com"
    assert result.cmds[1].name == "error"
    assert result.cmds[1].value == "Unavailable"
    assert !("email" in result.vals)
    field.validation = {
        typo: true
    }
    failed = false
    try
        field.definition()
    catch error
        assert error == "UiUnknownValidationRule: typo"
        failed = true
    assert failed
