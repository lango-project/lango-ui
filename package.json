{
  "name": "@lango-project/lango-ui",
  "version": "0.1.0",
  "description": "Server-driven UI protocol and control model for Lango applications.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./dist/library.mjs",
    "./replay": "./dist/replay.mjs"
  },
  "lango": {
    "source": "src/library.lango",
    "output": "dist/library.mjs"
  },
  "files": [
    "src/*.lango",
    "dist/**",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "lango build src/library.lango --out dist/library.mjs",
    "test": "lango test src/library.lango && lango run src/replay_test.lango"
  },
  "devDependencies": {
    "@lango-project/lango-js": "^0.1.8"
  },
  "engines": {
    "node": ">=24"
  }
}
